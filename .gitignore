# Environment and secrets
.env
*.env

# Config (contains user IDs and personal context)
config.json

# Personal memories (contains private context)
memories/*.json
!memories/*.template

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Java build artifacts (XMage bridge). July 10: the old rules/target/
# pattern didn't match the real nested path — a sweep commit picked up a
# 266MB H2 db and two 93MB shaded jars (GitHub rejects files >100MB).
rules/*.class
rules/target/
rules/xmage-bridge/target/
rules/xmage-bridge/db/

# XMage card database copy at repo root (regenerable, ~240MB)
db/

# Bot runtime caches (re-downloadable from Scryfall / regenerated at runtime)
data/card_images/
data/card_cache/
data/api_costs.json

# Bot memories (private context — the memories/*.json pattern above didn't
# cover this path)
data/memories.json

# Claude Code session-local worktree pointers
.claude/worktrees/

# Audit-script artifacts (tools/audit_card_cache.py)
data/card_data_cache.json.bak
audit_report*.json

# Scryfall bulk cache (tools/validate_card_names.py — ~170MB, re-downloadable)
data/scryfall_oracle_cards.json
data/scryfall_oracle_cards.part

# YouTube transcripts (may contain private content from links shared in DMs/server)
data/transcripts/


# Keep the bind-mount targets present in a fresh clone so Docker doesn't
# create them root-owned on first run (breaks rootless Docker). The dirs
# stay ignored; only the placeholders are tracked.
!logs/.gitkeep
!db/.gitkeep
!rules/xmage-bridge/target/.gitkeep
!rules/xmage-bridge/db/.gitkeep
