{
  "bot_persona": "plain",
  "mtg_channel_id": null,
  "excluded_channels": [],
  "_comments": {
    "bot_persona": "Name of a file under personas/ (without .json) — picks the character layer the bot speaks as when chatting in game threads. Defaults to 'plain' (no roleplay, just Claude). Try 'ressapanda' for a whimsical-red-panda persona, or write your own following personas/README.md.",
    "mtg_channel_id": "Discord channel ID where MTG games happen. The bot responds to every message in this channel even without being mentioned. Set to null to require @-mentions in other channels.",
    "excluded_channels": "Channel IDs where the bot should NEVER respond (even to commands). Useful if another bot owns that channel."
  }
}
