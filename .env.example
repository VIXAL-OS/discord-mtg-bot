# Discord Bot Token
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_token_here

# Anthropic API Key  
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional low-cost autoplay providers. Configure either or both; the batch
# preflight selects a healthy provider. Leave blank for Claude-only autoplay.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Optional Qwen overrides (defaults: qwen3.7-flash / qwen3.7-plus)
QWEN_ACTOR_MODEL=
